{
	"name": "t3-web-api-template",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "next build",
		"check": "biome check .",
		"check:unsafe": "biome check --write --unsafe .",
		"check:write": "biome check --write .",
		"db:generate": "prisma migrate dev",
		"db:migrate": "prisma migrate deploy",
		"db:push": "prisma db push",
		"db:reset": "prisma migrate reset --force",
		"db:seed": "prisma db seed",
		"db:studio": "prisma studio",
		"docker:app": "./scripts/docker-compose.sh -f docker-compose.app.yml up --build",
		"docker:db": "./scripts/docker-compose.sh up -d postgres",
		"dev": "next dev --turbo",
		"fmt": "biome format --write .",
		"lint": "biome lint .",
		"postinstall": "prisma generate",
		"prepare": "node scripts/install-hooks.mjs",
		"preview": "next build && next start",
		"react-doctor": "react-doctor . --yes --no-supply-chain --no-telemetry",
		"release:date": "node scripts/release-date.mjs --write",
		"release:date:check": "node scripts/release-date.mjs --check",
		"start": "next start",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"verify": "node scripts/verify.mjs"
	},
	"dependencies": {
		"@prisma/client": "^6.19.3",
		"@sentry/nextjs": "^10.73.0",
		"@t3-oss/env-nextjs": "^0.12.0",
		"@tanstack/react-query": "^5.102.8",
		"@trpc/client": "^11.18.0",
		"@trpc/react-query": "^11.18.0",
		"@trpc/server": "^11.18.0",
		"@upstash/ratelimit": "^2.0.8",
		"@upstash/redis": "^1.38.4",
		"next": "^16.3.4",
		"pino": "^10.3.1",
		"posthog-js": "^1.428.7",
		"posthog-node": "^5.51.7",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"server-only": "^0.0.1",
		"superjson": "^2.2.6",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^20.19.43",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"dotenv": "^17.4.2",
		"lefthook": "^2.1.12",
		"postcss": "^8.5.28",
		"prisma": "^6.19.3",
		"react-doctor": "^0.9.13",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.13",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11"
	},
	"ct3aMetadata": {
		"initVersion": "7.40.0"
	},
	"packageManager": "pnpm@11.8.0"
}
