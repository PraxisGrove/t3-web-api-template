{
	"name": "t3-web-api-template",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "next build",
		"check": "biome check .",
		"check:unsafe": "biome check --write --unsafe .",
		"check:write": "biome check --write .",
		"db:generate": "prisma migrate dev",
		"db:migrate": "prisma migrate deploy",
		"db:push": "prisma db push",
		"db:reset": "prisma migrate reset --force",
		"db:seed": "prisma db seed",
		"db:studio": "prisma studio",
		"docker:app": "./scripts/docker-compose.sh -f docker-compose.app.yml up --build",
		"docker:db": "./scripts/docker-compose.sh up -d postgres",
		"dev": "next dev --turbo",
		"fmt": "biome format --write .",
		"lint": "biome lint .",
		"postinstall": "prisma generate",
		"prepare": "lefthook install",
		"preview": "next build && next start",
		"release:date": "node scripts/release-date.mjs --write",
		"release:date:check": "node scripts/release-date.mjs --check",
		"start": "next start",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"verify": "node scripts/verify.mjs"
	},
	"dependencies": {
		"@prisma/client": "^6.6.0",
		"@sentry/nextjs": "^10.63.0",
		"@t3-oss/env-nextjs": "^0.12.0",
		"@tanstack/react-query": "^5.69.0",
		"@trpc/client": "^11.0.0",
		"@trpc/react-query": "^11.0.0",
		"@trpc/server": "^11.0.0",
		"@upstash/ratelimit": "^2.0.8",
		"@upstash/redis": "^1.38.0",
		"next": "^15.2.3",
		"pino": "^10.3.1",
		"posthog-js": "^1.398.0",
		"posthog-node": "^5.39.4",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"server-only": "^0.0.1",
		"superjson": "^2.2.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.5",
		"@tailwindcss/postcss": "^4.0.15",
		"@types/node": "^20.14.10",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"dotenv": "^17.4.2",
		"lefthook": "^2.1.9",
		"postcss": "^8.5.3",
		"prisma": "^6.6.0",
		"tailwindcss": "^4.0.15",
		"tsx": "^4.23.0",
		"typescript": "^5.8.2",
		"vitest": "^4.1.10"
	},
	"ct3aMetadata": {
		"initVersion": "7.40.0"
	},
	"packageManager": "pnpm@11.8.0"
}
